# cp terraform.tfvars.example terraform.tfvars

folder_id   = "b1gxxxxxxxxxx"
zone        = "ru-central1-a"
k8s_version = "1.32"

node_count     = 1
node_memory_gb = 64
cluster_name   = "minecraft-k8s"

enable_backups            = true
enable_lockbox            = true
enable_container_registry = true
enable_logging            = true
enable_dns                = false
enable_velero             = true
enable_node_autoscaling   = true
node_count_min            = 1
node_count_max            = 2
node_preemptible          = true

backup_bucket_name = "minecraft-world-backup-YOUR-FOLDER-SUFFIX"

# DNS (optional):
# enable_dns            = true
# dns_zone              = "example.com."
# minecraft_external_ip = "YOUR_LB_IP"
